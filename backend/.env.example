# ============================================================
# OLMS - Online Lottery Management System - Environment Config
# ============================================================
# Copy this file to .env and fill in your actual values.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
MONGODB_URI=mongodb+srv://olms_admin:mesay3964@cluster1.63zujig.mongodb.net/olms_admin?retryWrites=true&w=majority

# --- JWT ---
JWT_ACCESS_SECRET=your_very_long_and_secure_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_very_long_and_secure_refresh_secret_here_min_32_chars
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# --- Email (SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="OLMS System <noreply@olms.com>"

# --- Telebirr (Ethswitch) ---
TELEBIRR_APP_ID=your_telebirr_app_id
TELEBIRR_APP_KEY=your_telebirr_app_key
TELEBIRR_SHORT_CODE=your_short_code
TELEBIRR_PUBLIC_KEY=your_telebirr_rsa_public_key_base64
TELEBIRR_BASE_URL=https://api.ethiomobilemoney.et/ammapi/payment

# --- CBE Birr (Commercial Bank of Ethiopia) ---
CBE_MERCHANT_ID=your_cbe_merchant_id
CBE_API_KEY=your_cbe_api_key
CBE_BASE_URL=https://api.cbe.com.et/payment

# --- Frontend ---
FRONTEND_URL=http://localhost:3000

# --- Security ---
BCRYPT_ROUNDS=12
